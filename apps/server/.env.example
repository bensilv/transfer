PORT=8787

# "mta" (default) fetches the real public MTA GTFS-RT feeds on demand.
# "mock" generates deterministic demo data and needs no network access.
DATA_SOURCE=mta

# Only needed if MTA has moved the static GTFS bundle since this was written;
# check https://new.mta.info/developers if ingestion logs show a 404.
# GTFS_STATIC_URL=https://web.mta.info/developers/data/nyct/subway/google_transit.zip
