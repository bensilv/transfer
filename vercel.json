{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "apps/web/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "apps/server/src/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/server/src/index.ts" },
    { "src": "/assets/(.*)", "dest": "/apps/web/assets/$1" },
    { "src": "/favicon.svg", "dest": "/apps/web/favicon.svg" },
    { "src": "/icons.svg", "dest": "/apps/web/icons.svg" },
    { "src": "/(.*)", "dest": "/apps/web/index.html" }
  ]
}
